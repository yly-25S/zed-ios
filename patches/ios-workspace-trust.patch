+pub struct WorkspaceTrust {
+    workspace: WeakEntity<workspace::Workspace>,
+    worktree_store: Entity<WorktreeStore>,
+    prompted: bool,
+}
+
+impl WorkspaceTrust {
+    pub fn new(
+        workspace: WeakEntity<workspace::Workspace>,
+        worktree_store: Entity<WorktreeStore>,
+        window: &Window,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        if let Some(trusted_worktrees) = TrustedWorktrees::try_get_global(cx) {
+            cx.subscribe_in(&trusted_worktrees, window, |this, _, event, window, cx| {
+                let (TrustedWorktreesEvent::Trusted(store, _)
+                | TrustedWorktreesEvent::Restricted(store, _)) = event;
+                if *store == this.worktree_store.downgrade() {
+                    cx.notify();
+                    cx.defer_in(window, Self::prompt_if_needed);
+                }
+            })
+            .detach();
+        }
+        cx.subscribe_in(&worktree_store, window, |_, _, event, window, cx| {
+            if matches!(
+                event,
+                WorktreeStoreEvent::WorktreeAdded(_)
+                    | WorktreeStoreEvent::WorktreeRemoved(..)
+                    | WorktreeStoreEvent::WorktreeReleased(..)
+            ) {
+                cx.notify();
+                cx.defer_in(window, Self::prompt_if_needed);
+            }
+        })
+        .detach();
+
+        Self {
+            workspace,
+            worktree_store,
+            prompted: false,
+        }
+    }
+
+    fn is_restricted(&self, cx: &App) -> bool {
+        TrustedWorktrees::try_get_global(cx).is_some_and(|trusted_worktrees| {
+            trusted_worktrees
+                .read(cx)
+                .has_restricted_worktrees(&self.worktree_store, cx)
+        })
+    }
+
+    fn prompt_if_needed(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        if self.prompted || !self.is_restricted(cx) {
+            return;
+        }
+        // Background sessions must not steal focus from another workspace or the landing page.
+        let Some(Some(multi_workspace)) = window.root::<workspace::MultiWorkspace>() else {
+            return;
+        };
+        if multi_workspace.read(cx).workspace().downgrade() != self.workspace {
+            return;
+        }
+        self.workspace
+            .update(cx, |workspace, cx| {
+                if !workspace.has_active_modal(window, cx) {
+                    self.prompted = true;
+                    workspace.show_worktree_trust_security_modal(false, window, cx);
+                }
+            })
+            .log_err();
+    }
+}
+
+impl Render for WorkspaceTrust {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        div().when(self.is_restricted(cx), |this| {
+            this.child(
+                Button::new("workspace-trust", "Restricted Mode")
+                    .style(ButtonStyle::Tinted(TintColor::Warning))
+                    .label_size(LabelSize::Small)
+                    .color(Color::Warning)
+                    .start_icon(
+                        Icon::new(IconName::Warning)
+                            .size(IconSize::Small)
+                            .color(Color::Warning),
+                    )
+                    .tooltip(|_, cx| {
+                        Tooltip::for_action(
+                            "Trust Workspace",
+                            &workspace::ToggleWorktreeSecurity,
+                            cx,
+                        )
+                    })
+                    .on_click(cx.listener(|this, _, window, cx| {
+                        this.prompted = true;
+                        this.workspace
+                            .update(cx, |workspace, cx| {
+                                workspace.show_worktree_trust_security_modal(false, window, cx);
+                            })
+                            .log_err();
+                    })),
+            )
+        })
+    }
+}
