+//! SSH authentication without a dependency on the application UI.
+
+use anyhow::{Context as _, Result, bail};
+use futures::future::BoxFuture;
+use russh::{
+    MethodKind, MethodSet,
+    client::{AuthResult, Handle, Handler, KeyboardInteractiveAuthResponse},
+    keys::{PrivateKey, PrivateKeyWithHashAlg},
+};
+use std::sync::Arc;
+
+#[derive(Debug)]
+pub struct AuthenticationCancelled;
+
+impl std::fmt::Display for AuthenticationCancelled {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("SSH authentication cancelled")
+    }
+}
+
+impl std::error::Error for AuthenticationCancelled {}
+
+pub struct AuthenticationPrompt {
+    text: String,
+    echo: bool,
+}
+
+impl AuthenticationPrompt {
+    pub fn text(&self) -> &str {
+        &self.text
+    }
+
+    pub fn echo(&self) -> bool {
+        self.echo
+    }
+}
+
+pub struct AuthenticationChallenge {
+    name: String,
+    instructions: String,
+    prompts: Vec<AuthenticationPrompt>,
+}
+
+impl AuthenticationChallenge {
+    pub fn password(prompt: String) -> Self {
+        Self {
+            name: "SSH password".into(),
+            instructions: String::new(),
+            prompts: vec![AuthenticationPrompt {
+                text: prompt,
+                echo: false,
+            }],
+        }
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub fn instructions(&self) -> &str {
+        &self.instructions
+    }
+
+    pub fn prompts(&self) -> &[AuthenticationPrompt] {
+        &self.prompts
+    }
+}
+
+/// A prompt callback must return responses in prompt order, or an error on cancellation.
+/// Stored passwords are only used with the SSH password method, never for server prompts.
+pub async fn authenticate<H: Handler>(
+    handle: &mut Handle<H>,
+    username: &str,
+    keys: Vec<Arc<PrivateKey>>,
+    mut password: Option<String>,
+    mut prompt: impl FnMut(AuthenticationChallenge) -> BoxFuture<'static, Result<Vec<String>>> + Send,
+) -> Result<()> {
+    let mut result = handle
+        .authenticate_none(username)
+        .await
+        .context("Could not query SSH authentication methods")?;
+    let mut keys = keys.into_iter();
+    let mut password_attempts = 0;
+    let mut keyboard_attempts = 0;
+    let mut rejected = false;
+    let mut partial = false;
+
+    loop {
+        let methods = match result {
+            AuthResult::Success => return Ok(()),
+            AuthResult::Failure {
+                remaining_methods,
+                partial_success,
+            } => {
+                if partial_success {
+                    // A completed factor is not a rejection. Start a new authentication stage.
+                    partial = true;
+                    password_attempts = 0;
+                    keyboard_attempts = 0;
+                    rejected = false;
+                }
+                remaining_methods
+            }
+        };
+
+        if methods.contains(&MethodKind::PublicKey) {
+            if let Some(key) = keys.next() {
+                let hash = handle.best_supported_rsa_hash().await?.flatten();
+                result = handle
+                    .authenticate_publickey(username, PrivateKeyWithHashAlg::new(key, hash))
+                    .await?;
+                rejected = true;
+                continue;
+            }
+        }
+
+        // Try the ordinary password first, then a keyboard-interactive alternative before
+        // asking for a second password. Each rejected method has a bounded retry count.
+        if methods.contains(&MethodKind::Password)
+            && (password_attempts == 0
+                || (password_attempts < 2
+                    && (!methods.contains(&MethodKind::KeyboardInteractive)
+                        || keyboard_attempts >= 2)))
+        {
+            let response = match password.take() {
+                Some(password) => password,
+                None => {
+                    let mut responses =
+                        prompt(AuthenticationChallenge::password("Password:".into())).await?;
+                    if responses.len() != 1 {
+                        bail!("The SSH password prompt returned an invalid response count");
+                    }
+                    responses.remove(0)
+                }
+            };
+            password_attempts += 1;
+            result = handle.authenticate_password(username, response).await?;
+            rejected = true;
+            continue;
+        }
+
+        if methods.contains(&MethodKind::KeyboardInteractive) && keyboard_attempts < 2 {
+            keyboard_attempts += 1;
+            let mut response = handle
+                .authenticate_keyboard_interactive_start(username, None)
+                .await?;
+            result = loop {
+                match response {
+                    KeyboardInteractiveAuthResponse::Success => break AuthResult::Success,
+                    KeyboardInteractiveAuthResponse::Failure {
+                        remaining_methods,
+                        partial_success,
+                    } => {
+                        break AuthResult::Failure {
+                            remaining_methods,
+                            partial_success,
+                        };
+                    }
+                    KeyboardInteractiveAuthResponse::InfoRequest {
+                        name,
+                        instructions,
+                        prompts,
+                    } => {
+                        // Empty protocol prompts require empty responses. Other prompts, including
+                        // visible username and hidden OTP fields, always require explicit user input.
+                        let mut responses = vec![String::new(); prompts.len()];
+                        let positions = prompts
+                            .iter()
+                            .enumerate()
+                            .filter_map(|(index, prompt)| {
+                                (!prompt.prompt.is_empty()).then_some(index)
+                            })
+                            .collect::<Vec<_>>();
+                        let challenge = AuthenticationChallenge {
+                            name,
+                            instructions,
+                            prompts: prompts
+                                .into_iter()
+                                .filter(|prompt| !prompt.prompt.is_empty())
+                                .map(|prompt| AuthenticationPrompt {
+                                    text: prompt.prompt,
+                                    echo: prompt.echo,
+                                })
+                                .collect(),
+                        };
+                        if !challenge.prompts.is_empty()
+                            || !challenge.name.is_empty()
+                            || !challenge.instructions.is_empty()
+                        {
+                            let answers = prompt(challenge).await?;
+                            if answers.len() != positions.len() {
+                                bail!(
+                                    "The SSH authentication prompt returned an invalid response count"
+                                );
+                            }
+                            for (position, answer) in positions.into_iter().zip(answers) {
+                                responses[position] = answer;
+                            }
+                        }
+                        response = handle
+                            .authenticate_keyboard_interactive_respond(responses)
+                            .await?;
+                    }
+                }
+            };
+            rejected = true;
+            continue;
+        }
+
+        return Err(authentication_error(&methods, rejected, partial));
+    }
+}
+
+fn authentication_error(methods: &MethodSet, rejected: bool, partial: bool) -> anyhow::Error {
+    let methods = methods
+        .iter()
+        .map(<&str>::from)
+        .collect::<Vec<_>>()
+        .join(", ");
+    let methods = if methods.is_empty() { "none" } else { &methods };
+    if rejected {
+        anyhow::anyhow!(
+            "SSH authentication was rejected. Check your credentials or required authentication factors. Server methods: {methods}"
+        )
+    } else if partial {
+        anyhow::anyhow!(
+            "SSH authentication needs another factor, but no supported method or usable local key is available. Server methods: {methods}"
+        )
+    } else {
+        anyhow::anyhow!(
+            "No supported SSH authentication method or usable local key is available. Server methods: {methods}"
+        )
+    }
+}
