@@ -0,0 +1,283 @@
+use anyhow::{Context as _, Result};
+use askpass::EncryptedPassword;
+use editor::Editor;
+use futures::{FutureExt as _, channel::oneshot};
+use gpui::{
+    AnyWindowHandle, AsyncApp, DismissEvent, Entity, EventEmitter, FocusHandle, Focusable, Global,
+    WeakEntity,
+};
+use remote::AuthenticationChallenge;
+use std::sync::Arc;
+use ui::prelude::*;
+use util::ResultExt as _;
+
+#[derive(Default)]
+struct PromptGate(Arc<futures::lock::Mutex<()>>);
+impl Global for PromptGate {}
+
+type Response = Result<Vec<EncryptedPassword>>;
+
+pub fn request(
+    window: AnyWindowHandle,
+    endpoint: String,
+    challenge: AuthenticationChallenge,
+    mut response: oneshot::Sender<Response>,
+    cx: &mut AsyncApp,
+) {
+    let gate = cx.update(|cx| cx.default_global::<PromptGate>().0.clone());
+    cx.spawn(async move |cx| {
+        // Auto-connect can authenticate several hosts at once. Never overwrite an active prompt.
+        let _guard = gate.lock().await;
+        if response.is_canceled() {
+            return;
+        }
+        let (send, receive) = oneshot::channel();
+        let shown = window.update(cx, |_, window, cx| {
+            if let Some(Some(landing)) = window.root::<crate::connection_landing::ConnectionLanding>() {
+                let prompt = cx.new(|cx| AuthenticationPrompt::new(endpoint, challenge, send, window, cx));
+                let weak = prompt.downgrade();
+                landing.update(cx, |landing, cx| landing.show_authentication_prompt(prompt, window, cx));
+                Ok(weak)
+            } else if let Some(Some(multi)) = window.root::<workspace::MultiWorkspace>() {
+                let workspace = multi.read(cx).workspace().clone();
+                workspace.update(cx, |workspace, cx| {
+                    anyhow::ensure!(!workspace.has_active_modal(window, cx),
+                        "Close the open dialog and reconnect to enter SSH authentication responses");
+                    workspace.toggle_modal(window, cx, |window, cx| {
+                        AuthenticationPrompt::new(endpoint, challenge, send, window, cx)
+                    });
+                    workspace.active_modal::<AuthenticationPrompt>(cx)
+                        .map(|prompt| prompt.downgrade())
+                        .context("Could not open the SSH authentication dialog")
+                })
+            } else {
+                anyhow::bail!("SSH authentication is unavailable in this window")
+            }
+        }).and_then(|shown| shown);
+        let prompt: WeakEntity<AuthenticationPrompt> = match shown {
+            Ok(prompt) => prompt,
+            Err(error) => {
+                if response.send(Err(error)).is_err() {
+                    log::debug!("SSH authentication request no longer active");
+                }
+                return;
+            }
+        };
+        let result = {
+            let cancelled = response.cancellation().fuse();
+            let receive = receive.fuse();
+            futures::pin_mut!(cancelled, receive);
+            futures::select! {
+                _ = cancelled => None,
+                result = receive => Some(result.map_err(|_| anyhow::Error::from(remote::AuthenticationCancelled)).and_then(|result| result)),
+            }
+        };
+        // Also close the UI if its connection task was cancelled while waiting for the user.
+        if prompt.is_upgradable() {
+            prompt.update(cx, |_, cx| cx.emit(DismissEvent)).log_err();
+        }
+        if let Some(result) = result {
+            // Send errors contain responses, which must never be logged.
+            if response.send(result).is_err() {
+                log::debug!("SSH authentication request no longer active");
+            }
+        }
+    }).detach();
+}
+
+pub struct AuthenticationPrompt {
+    endpoint: String,
+    challenge: AuthenticationChallenge,
+    editors: Vec<Entity<Editor>>,
+    focus_handle: FocusHandle,
+    cancel_focus: FocusHandle,
+    continue_focus: FocusHandle,
+    response: Option<oneshot::Sender<Response>>,
+    error: Option<SharedString>,
+}
+
+impl AuthenticationPrompt {
+    fn new(
+        endpoint: String,
+        challenge: AuthenticationChallenge,
+        response: oneshot::Sender<Response>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let editors = challenge
+            .prompts()
+            .iter()
+            .map(|prompt| {
+                cx.new(|cx| {
+                    let mut editor = Editor::single_line(window, cx);
+                    editor.set_masked(!prompt.echo(), cx);
+                    editor
+                })
+            })
+            .collect();
+        Self {
+            endpoint,
+            challenge,
+            editors,
+            focus_handle: cx.focus_handle(),
+            cancel_focus: cx.focus_handle(),
+            continue_focus: cx.focus_handle(),
+            response: Some(response),
+            error: None,
+        }
+    }
+
+    fn submit(&mut self, cx: &mut Context<Self>) {
+        let answers = self
+            .editors
+            .iter()
+            .map(|editor| EncryptedPassword::try_from(editor.read(cx).text(cx).as_str()))
+            .collect::<Result<Vec<_>>>();
+        match answers {
+            Ok(answers) => self.finish(Ok(answers), cx),
+            Err(_) => {
+                self.error = Some("Could not prepare authentication responses. Try again.".into());
+                cx.notify();
+            }
+        }
+    }
+
+    fn finish(&mut self, result: Response, cx: &mut Context<Self>) {
+        if let Some(response) = self.response.take() {
+            if response.send(result).is_err() {
+                log::debug!("SSH authentication request no longer active");
+            }
+        }
+        cx.emit(DismissEvent);
+    }
+
+    fn cancel(&mut self, cx: &mut Context<Self>) {
+        self.finish(Err(remote::AuthenticationCancelled.into()), cx);
+    }
+
+    fn move_focus(&self, backwards: bool, window: &mut Window, cx: &mut App) {
+        let handles = self
+            .editors
+            .iter()
+            .map(|editor| editor.focus_handle(cx))
+            .chain([self.cancel_focus.clone(), self.continue_focus.clone()])
+            .collect::<Vec<_>>();
+        let current = handles
+            .iter()
+            .position(|handle| handle.contains_focused(window, cx))
+            .unwrap_or(0);
+        let next = if backwards {
+            (current + handles.len() - 1) % handles.len()
+        } else {
+            (current + 1) % handles.len()
+        };
+        if let Some(handle) = handles.get(next) {
+            handle.focus(window, cx);
+        }
+    }
+}
+
+impl Focusable for AuthenticationPrompt {
+    fn focus_handle(&self, cx: &App) -> FocusHandle {
+        self.editors
+            .first()
+            .map(|editor| editor.focus_handle(cx))
+            .unwrap_or_else(|| self.continue_focus.clone())
+    }
+}
+impl EventEmitter<DismissEvent> for AuthenticationPrompt {}
+impl workspace::ModalView for AuthenticationPrompt {
+    fn fade_out_background(&self) -> bool {
+        true
+    }
+}
+
+impl Render for AuthenticationPrompt {
+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let colors = cx.theme().colors();
+        v_flex()
+            .id("ssh-authentication")
+            .key_context("SshAuthentication")
+            .track_focus(&self.focus_handle)
+            .on_action(cx.listener(|this, _: &menu::Confirm, window, cx| {
+                if this.cancel_focus.is_focused(window) {
+                    this.cancel(cx);
+                } else {
+                    this.submit(cx);
+                }
+            }))
+            .on_action(cx.listener(|this, _: &menu::Cancel, _, cx| this.cancel(cx)))
+            .on_action(cx.listener(|this, _: &menu::SelectNext, window, cx| {
+                this.move_focus(false, window, cx)
+            }))
+            .on_action(cx.listener(|this, _: &menu::SelectPrevious, window, cx| {
+                this.move_focus(true, window, cx)
+            }))
+            .w(rems(32.))
+            .max_w(
+                (window.viewport_size().width - rems(2.).to_pixels(window.rem_size())).max(px(0.)),
+            )
+            .max_h(
+                (window.viewport_size().height - rems(7.).to_pixels(window.rem_size())).max(px(0.)),
+            )
+            .overflow_y_scroll()
+            .p_4()
+            .gap_3()
+            .rounded_lg()
+            .border_1()
+            .border_color(colors.border)
+            .bg(colors.elevated_surface_background)
+            .child(Label::new("SSH authentication"))
+            .when(!self.endpoint.is_empty(), |this| {
+                this.child(Label::new(self.endpoint.clone()).color(Color::Muted))
+            })
+            .when(!self.challenge.name().is_empty(), |this| {
+                this.child(Label::new(self.challenge.name().to_owned()))
+            })
+            .when(!self.challenge.instructions().is_empty(), |this| {
+                this.child(Label::new(self.challenge.instructions().to_owned()).color(Color::Muted))
+            })
+            .children(
+                self.challenge
+                    .prompts()
+                    .iter()
+                    .zip(&self.editors)
+                    .enumerate()
+                    .map(|(position, (prompt, editor))| {
+                        // SSH response positions are stable identities within this immutable challenge.
+                        v_flex()
+                            .id(("ssh-authentication-field", position))
+                            .gap_1()
+                            .child(Label::new(prompt.text().to_owned()))
+                            .child(
+                                div()
+                                    .p_2()
+                                    .rounded_md()
+                                    .border_1()
+                                    .border_color(colors.border)
+                                    .bg(colors.editor_background)
+                                    .child(editor.clone()),
+                            )
+                    }),
+            )
+            .when_some(self.error.clone(), |this, error| {
+                this.child(Label::new(error).color(Color::Error))
+            })
+            .child(
+                h_flex()
+                    .gap_2()
+                    .justify_end()
+                    .child(
+                        Button::new("cancel-authentication", "Cancel")
+                            .track_focus(&self.cancel_focus)
+                            .on_click(cx.listener(|this, _, _, cx| this.cancel(cx))),
+                    )
+                    .child(
+                        Button::new("continue-authentication", "Continue")
+                            .track_focus(&self.continue_focus)
+                            .style(ButtonStyle::Filled)
+                            .on_click(cx.listener(|this, _, _, cx| this.submit(cx))),
+                    ),
+            )
+    }
+}
